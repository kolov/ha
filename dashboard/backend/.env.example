# Copy to .env and fill in HA_TOKEN. .env is gitignored — never commit it.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=paste-your-long-lived-access-token-here
VM_URL=http://homeassistant.local:8428
# Optional shared secret to gate limit edits. If set, the UI prompts for it
# before saving and random LAN hosts can't change thresholds. Leave empty to
# allow open writes (e.g. fully trusted network).
DASHBOARD_TOKEN=
